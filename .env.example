# Reference only. Run pnpm env:local to generate unique local credentials.
# Do not use these placeholders for an actual environment.
APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://lumio_app:replace-with-generated-local-value@127.0.0.1:5432/lumio
MIGRATION_DATABASE_URL=postgresql://lumio_migrator:replace-with-generated-local-value@127.0.0.1:5432/lumio
ADMIN_DATABASE_URL=postgresql://postgres:replace-with-generated-local-value@127.0.0.1:5432/lumio
POSTGRES_ADMIN_PASSWORD=replace-with-generated-local-value
BETTER_AUTH_SECRET=replace-with-a-random-value-of-at-least-32-characters
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=lumio@example.invalid
# Only for local/CI production builds. Never configure this on hosted staging.
LUMIO_LOCAL_TEST=1
# Run pnpm env:worker to add unique worker credentials to an existing F0.2 setup.
# The web receives JOB_PAYLOAD_KEY only; worker credentials stay outside the web env.
WORKER_DATABASE_URL=postgresql://lumio_worker:replace-with-generated-local-value@127.0.0.1:5432/lumio
REDIS_URL=redis://127.0.0.1:6379
JOB_PAYLOAD_KEY=replace-with-64-random-hex-characters
WORKER_HEALTH_PORT=3103
