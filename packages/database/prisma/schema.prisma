generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  person           Person?
  memberships      OrganizationMembership[]
  platformRoles    PlatformRole[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId], map: "session_user_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
  @@index([userId], map: "account_user")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier], map: "verification_identifier")
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  verified    Boolean @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId], map: "two_factor_user")
  @@map("twoFactor")
}

model Person {
  id        String @id @default(uuid())
  userId    String? @unique
  firstName String?
  lastName  String?
  phone String?
  birthDate String?
  address String?
  city String?
  province String?
  postalCode String?
  country String?
  profileVersion Int @default(1)
  registrations Registration[]
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@map("person")
}

model Organization {
  id           String @id @default(uuid())
  name         String
  slug         String @unique
  contactEmail String
  status       String @default("active")
  createdAt    DateTime @default(now())
  memberships  OrganizationMembership[]
  auditEvents  AuditEvent[]
  invitations OrganizationInvitation[]
  contests Contest[]
  @@map("organization")
}

model OrganizationInvitation {
  id String @id @default(uuid())
  organizationId String
  email String
  tokenHash String @unique
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  acceptedByUserId String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  outboxEvents OutboxEvent[]
  @@index([organizationId, createdAt])
  @@map("organization_invitation")
}

model OutboxEvent {
  id String @id @default(uuid())
  organizationId String?
  invitationId String?
  registrationId String?
  type String
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  invitation OrganizationInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  @@unique([type, registrationId])
  @@index([status, updatedAt])
  @@map("outbox_event")
}

model PlatformAudit {
  id String @id @default(uuid())
  actorUserId String?
  actorKind String @default("user")
  organizationId String?
  action String
  entityId String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
  @@map("platform_audit")
}

model OrganizationMembership {
  id             String @id @default(uuid())
  organizationId String
  userId         String
  role           String @default("admin")
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId], map: "membership_user")
  @@map("organization_membership")
}

model PlatformRole {
  userId String
  role   String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, role])
  @@map("platform_role")
}

model AuditEvent {
  id                String @id @default(uuid())
  organizationId    String
  actorUserId       String
  actorMembershipId String
  action            String
  entityId          String
  before            Json?
  after             Json?
  createdAt         DateTime @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId, createdAt], map: "audit_organization_created")
  @@map("audit_event")
}

model Contest {
  id String @id @default(uuid())
  organizationId String
  name String
  slug String
  description String @default("")
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  editions Edition[]
  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@map("contest")
}

model Edition {
  id String @id @default(uuid())
  organizationId String
  contestId String
  name String
  slug String
  identifier String
  status String @default("draft")
  version Int @default(1)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  contest Contest @relation(fields: [organizationId, contestId], references: [organizationId, id], onDelete: Restrict)
  sections Section[]
  revisions EditionRevision[]
  @@unique([organizationId, id])
  @@unique([organizationId, contestId, slug])
  @@map("edition")
}

model Section {
  id String @id @default(uuid())
  organizationId String
  editionId String
  name String
  code String
  description String
  theme String
  type String
  minImages Int
  maxImages Int
  feeCents Int
  specificRules String
  position Int
  edition Edition @relation(fields: [organizationId, editionId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, editionId, code])
  @@index([organizationId, editionId, position])
  @@map("section")
}

model EditionRevision {
  id String @id @default(uuid())
  organizationId String
  editionId String
  version Int
  configuration Json
  actorUserId String
  createdAt DateTime @default(now())
  edition Edition @relation(fields: [organizationId, editionId], references: [organizationId, id], onDelete: Restrict)
  registrations Registration[]
  @@unique([organizationId, editionId, version])
  @@map("edition_revision")
}

model Registration {
  id String @id @default(uuid())
  organizationId String
  editionId String
  editionVersion Int
  personId String
  organizationName String
  contestName String
  contactEmail String
  profileSnapshot Json
  configurationSnapshot Json
  status String
  version Int @default(1)
  regulationsAcceptedAt DateTime @default(now())
  privacyAcknowledgedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  revision EditionRevision @relation(fields: [organizationId, editionId, editionVersion], references: [organizationId, editionId, version], onDelete: Restrict)
  events RegistrationEvent[]
  outboxEvents OutboxEvent[]
  @@unique([organizationId, id])
  @@unique([editionId, personId])
  @@index([organizationId, editionId, createdAt])
  @@map("registration")
}

model RegistrationEvent {
  id String @id @default(uuid())
  organizationId String
  registrationId String
  actorUserId String
  action String
  before Json
  after Json
  createdAt DateTime @default(now())
  registration Registration @relation(fields: [organizationId, registrationId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, registrationId, createdAt])
  @@map("registration_event")
}
