{
  "name": "lumio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "pnpm db:generate && pnpm --filter lumio-web dev",
    "build": "pnpm db:generate && pnpm --filter lumio-web build",
    "start": "pnpm --filter lumio-web start",
    "start:hosted": "pnpm --filter lumio-web start:hosted",
    "typecheck": "pnpm db:generate && pnpm --filter @lumio/database typecheck && pnpm --filter lumio-web typecheck && tsc --project tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm build && node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "db:generate": "pnpm --filter @lumio/database generate",
    "env:local": "node --import tsx scripts/configure-local.ts",
    "db:provision": "node --env-file-if-exists=.env --import tsx scripts/provision-database.ts",
    "db:migrate": "pnpm --filter @lumio/database migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-development.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test tests/integration/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lumio/database": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.12.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
