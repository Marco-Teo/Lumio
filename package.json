{
  "name": "lumio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "pnpm --filter lumio-web dev",
    "build": "pnpm --filter lumio-web build",
    "start": "pnpm --filter lumio-web start",
    "typecheck": "pnpm --filter lumio-web typecheck && tsc --project tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.12.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
